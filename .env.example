# Copy to .env only if one does not already exist. Never commit filled values.
# Quote values containing spaces or #. Values are data; do not use shell expansions.
GAMESHELL_IP=
GAMESHELL_USERNAME=cpi
GAMESHELL_USB_IP=192.168.10.1
GAMESHELL_WIFI_SSID=
# Confirmed ISO 3166-1 alpha-2 country, e.g. NZ; never inferred from location/timezone.
GAMESHELL_WIFI_COUNTRY=
# Wi-Fi passphrase (8-63 bytes) or its 64-character hexadecimal PSK.
GAMESHELL_WIFI_PSK=
M2_MACBOOK_AIR_IP=
M2_MACBOOK_AIR_USERNAME=
M2_MACBOOK_AIR_PASSWORD=
# Optional SSH key for the Mac; otherwise use password/agent authentication.
M2_MACBOOK_AIR_KEY=
# Optional separate sudo password; defaults to the Mac SSH password if omitted.
# M2_MACBOOK_AIR_SUDO_PASSWORD=
# SSH private key material stays in permission-restricted files, referenced here.
NEO_SSH_KEY=.local/ssh/id_ed25519
NEO_HOST_PUBLIC_KEY=.local/provisioning/device/ssh_host_ed25519_key.pub
