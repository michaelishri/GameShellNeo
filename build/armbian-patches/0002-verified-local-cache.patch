 function is_artifact_available_in_local_cache() {
+	# A GameShellNeo rootfs cache is accepted only by its recorded content hash.
+	if [[ "${NEO_LOCAL_CACHE_ONLY:-no}" == yes && "${artifact_type}" == tar.zst ]]; then
+		artifact_exists_in_local_cache=no
+		if [[ "${artifact_final_file_basename}" == "${NEO_ROOTFS_CACHE_NAME}" && -f "${artifact_final_file}" ]] &&
+			[[ "$(sha256sum "${artifact_final_file}" | cut -d' ' -f1)" == "${NEO_ROOTFS_CACHE_SHA}" ]]; then
+			artifact_exists_in_local_cache=yes
+		fi
+		return 0
+	fi
 	artifact_exists_in_local_cache="no" # outer scope
 
 	if [[ "${artifact_type}" == "deb-tar" ]]; then
