From: GameShellNeo project
Subject: [PATCH] brcmfmac: preserve watchdog failure ownership

Recheck I/O admission under each watchdog host claim. Stop on status,
console wake/read and idle sleep transport failures using the existing
host-serialized error cleanup. Keep local console allocation/format errors
separate from transport errors and preserve successful scheduling.
Candidate only; later image and hardware qualification are separate.

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/sdio.c
@@ -3075,13 +3075,15 @@
 #ifdef DEBUG
 #define CONSOLE_LINE_MAX	192
 
-static int brcmf_sdio_readconsole(struct brcmf_sdio *bus)
+static int brcmf_sdio_readconsole(struct brcmf_sdio *bus, int *ioerr)
 {
 	struct brcmf_console *c = &bus->console;
 	u8 line[CONSOLE_LINE_MAX], ch;
 	u32 n, idx, addr;
 	int rv;
 
+	*ioerr = 0;
+
 	/* Don't do anything until FWREADY updates console address */
 	if (bus->console_addr == 0)
 		return 0;
@@ -3090,8 +3092,10 @@
 	addr = bus->console_addr + offsetof(struct rte_console, log_le);
 	rv = brcmf_sdiod_ramrw(bus->sdiodev, false, addr, (u8 *)&c->log_le,
 			       sizeof(c->log_le));
-	if (rv < 0)
+	if (rv < 0) {
+		*ioerr = rv;
 		return rv;
+	}
 
 	/* Allocate console buffer (one time only) */
 	if (c->buf == NULL) {
@@ -3115,8 +3119,10 @@
 	/* Read the console buffer */
 	addr = le32_to_cpu(c->log_le.buf);
 	rv = brcmf_sdiod_ramrw(bus->sdiodev, false, addr, c->buf, c->bufsize);
-	if (rv < 0)
+	if (rv < 0) {
+		*ioerr = rv;
 		return rv;
+	}
 
 	while (c->last != idx) {
 		for (n = 0; n < CONSOLE_LINE_MAX - 2; n++) {
@@ -3917,12 +3923,17 @@
 
 static void brcmf_sdio_bus_watchdog(struct brcmf_sdio *bus)
 {
+	struct brcmf_sdio_dev *sdiod = bus->sdiodev;
+	int err;
+
+	if (brcmf_sdiod_io_blocked(sdiod))
+		return;
 	brcmf_dbg(TIMER, "Enter\n");
 
 	/* Poll period: check device if appropriate. */
 	if (!bus->sr_enabled &&
 	    bus->poll && (++bus->polltick >= bus->pollrate)) {
-		u32 intstatus = 0;
+		u32 intstatus;
 
 		/* Reset poll tick */
 		bus->polltick = 0;
@@ -3930,26 +3941,27 @@
 		/* Check device if no interrupts */
 		if (!bus->intr ||
 		    (bus->sdcnt.intrcount == bus->sdcnt.lastintrs)) {
-
 			if (!bus->dpc_triggered) {
 				u8 devpend;
 
-				sdio_claim_host(bus->sdiodev->func1);
-				devpend = brcmf_sdiod_func0_rb(bus->sdiodev,
-						  SDIO_CCCR_INTx, NULL);
-				sdio_release_host(bus->sdiodev->func1);
+				sdio_claim_host(sdiod->func1);
+				if (brcmf_sdiod_io_blocked(sdiod))
+					goto release;
+				devpend = brcmf_sdiod_func0_rb(sdiod,
+							       SDIO_CCCR_INTx, &err);
+				if (err)
+					goto failed;
 				intstatus = devpend & (INTR_STATUS_FUNC1 |
 						       INTR_STATUS_FUNC2);
-			}
-
-			/* If there is something, make like the ISR and
-				 schedule the DPC */
-			if (intstatus) {
-				bus->sdcnt.pollcnt++;
-				atomic_set(&bus->ipend, 1);
-
-				bus->dpc_triggered = true;
-				queue_work(bus->brcmf_wq, &bus->datawork);
+
+				/* Publish before another claimant can retire the bus. */
+				if (intstatus) {
+					bus->sdcnt.pollcnt++;
+					atomic_set(&bus->ipend, 1);
+					bus->dpc_triggered = true;
+					queue_work(bus->brcmf_wq, &bus->datawork);
+				}
+				sdio_release_host(sdiod->func1);
 			}
 		}
 
@@ -3963,13 +3975,19 @@
 		bus->console.count += jiffies_to_msecs(BRCMF_WD_POLL);
 		if (bus->console.count >= bus->console_interval) {
 			bus->console.count -= bus->console_interval;
-			sdio_claim_host(bus->sdiodev->func1);
+			sdio_claim_host(sdiod->func1);
+			if (brcmf_sdiod_io_blocked(sdiod))
+				goto release;
 			/* Make sure backplane clock is on */
-			brcmf_sdio_bus_sleep(bus, false, false);
-			if (brcmf_sdio_readconsole(bus) < 0)
+			err = brcmf_sdio_bus_sleep(bus, false, false);
+			if (err)
+				goto failed;
+			if (brcmf_sdio_readconsole(bus, &err) < 0)
 				/* stop on error */
 				bus->console_interval = 0;
-			sdio_release_host(bus->sdiodev->func1);
+			if (err)
+				goto failed;
+			sdio_release_host(sdiod->func1);
 		}
 	}
 #endif				/* DEBUG */
@@ -3982,15 +4000,19 @@
 			bus->idlecount++;
 			if (bus->idlecount > bus->idletime) {
 				brcmf_dbg(SDIO, "idle\n");
-				sdio_claim_host(bus->sdiodev->func1);
+				sdio_claim_host(sdiod->func1);
+				if (brcmf_sdiod_io_blocked(sdiod))
+					goto release;
 #ifdef DEBUG
 				if (!BRCMF_FWCON_ON() ||
 				    bus->console_interval == 0)
 #endif
 					brcmf_sdio_wd_timer(bus, false);
 				bus->idlecount = 0;
-				brcmf_sdio_bus_sleep(bus, true, false);
-				sdio_release_host(bus->sdiodev->func1);
+				err = brcmf_sdio_bus_sleep(bus, true, false);
+				if (err)
+					goto failed;
+				sdio_release_host(sdiod->func1);
 			}
 		} else {
 			bus->idlecount = 0;
@@ -3998,6 +4020,13 @@
 	} else {
 		bus->idlecount = 0;
 	}
+	return;
+
+failed:
+	/* Shared error cleanup is serialized by the SDIO host claim. */
+	brcmf_sdio_dpc_failed(bus, err);
+release:
+	sdio_release_host(sdiod->func1);
 }
 
 static void brcmf_sdio_dataworker(struct work_struct *work)
