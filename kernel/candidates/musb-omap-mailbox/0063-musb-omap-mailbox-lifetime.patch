From: GameShellNeo maintainers
Subject: [PATCH] usb: musb: retire OMAP mailbox and parent-PM child users

Keep one owned mailbox publisher and drain admitted atomic dispatch before
closing backend work. Retire sleepable OMAP child users with SRCU before
clients or PHY resources disappear. Retain the cached status level for
initial state on rebind; no old actor crosses child retirement.

The parent runtime callbacks keep their admitted hardware/PM sequence. This
does not establish failed-power MMIO safety, DMA retirement or system PM.

---

--- a/drivers/usb/musb/musb_core.c
+++ b/drivers/usb/musb/musb_core.c
@@ -65,6 +65,7 @@
  */
 
 #include <linux/module.h>
+#include <linux/srcu.h>
 #include <linux/kernel.h>
 #include <linux/sched.h>
 #include <linux/slab.h>
@@ -1831,22 +1832,64 @@
 #define use_dma			0
 #endif
 
-static int (*musb_phy_callback)(enum musb_vbus_id_status status);
+static DEFINE_MUTEX(musb_mailbox_lock);
+DEFINE_STATIC_SRCU(musb_mailbox_srcu);
+static struct musb __rcu *musb_mailbox_owner;
+
+static int musb_register_mailbox(struct musb *musb)
+{
+	int ret = 0;
+
+	if (!musb->ops->phy_callback)
+		return 0;
+	if (!musb->ops->phy_callback_quiesce)
+		return -EINVAL;
+
+	mutex_lock(&musb_mailbox_lock);
+	if (rcu_access_pointer(musb_mailbox_owner))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(musb_mailbox_owner, musb);
+	mutex_unlock(&musb_mailbox_lock);
+	return ret;
+}
+
+/* Process context, outside musb->lock, before clients or resources retire. */
+static void musb_quiesce_mailbox(struct musb *musb)
+{
+	if (!musb->ops->phy_callback)
+		return;
+
+	mutex_lock(&musb_mailbox_lock);
+	if (rcu_access_pointer(musb_mailbox_owner) == musb) {
+		RCU_INIT_POINTER(musb_mailbox_owner, NULL);
+		synchronize_srcu(&musb_mailbox_srcu);
+	}
+	/* Also close backend admission after a failed registration attempt. */
+	if (musb->ops->phy_callback_quiesce)
+		musb->ops->phy_callback_quiesce(musb);
+	mutex_unlock(&musb_mailbox_lock);
+}
 
 /*
- * musb_mailbox - optional phy notifier function
- * @status phy state change
+ * musb_mailbox - optional non-sleeping PHY event publication
+ * @status: PHY state change
  *
- * Optionally gets called from the USB PHY. Note that the USB PHY must be
- * disabled at the point the phy_callback is registered or unregistered.
+ * SRCU protects the owning controller and backend callback in atomic callers.
+ * The callback only records status and queues work; retirement drains both.
  */
 int musb_mailbox(enum musb_vbus_id_status status)
 {
-	if (musb_phy_callback)
-		return musb_phy_callback(status);
-
-	return -ENODEV;
-};
+	struct musb *musb;
+	int idx, ret = -ENODEV;
+
+	idx = srcu_read_lock(&musb_mailbox_srcu);
+	musb = srcu_dereference(musb_mailbox_owner, &musb_mailbox_srcu);
+	if (musb)
+		ret = musb->ops->phy_callback(musb, status);
+	srcu_read_unlock(&musb_mailbox_srcu, idx);
+	return ret;
+}
 EXPORT_SYMBOL_GPL(musb_mailbox);
 
 /*-------------------------------------------------------------------------*/
@@ -2460,6 +2503,7 @@
 		return status;
 
 cleanup:
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	/* Keep core IRQ, DMA and platform resources alive for client cleanup. */
 	if (gadget_registered)
@@ -2625,8 +2669,9 @@
 		musb->xceiv->io_ops = &musb_ulpi_access;
 	}
 
-	if (musb->ops->phy_callback)
-		musb_phy_callback = musb->ops->phy_callback;
+	status = musb_register_mailbox(musb);
+	if (status)
+		goto fail2;
 
 	/*
 	 * We need musb_read/write functions initialized for PM.
@@ -2717,6 +2762,7 @@
 	return 0;
 
 fail3:
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	musb_disable_runtime_pm(musb);
 	musb_shutdown_irq(musb);
@@ -2726,6 +2772,7 @@
 	goto shutdown_phy;
 
 fail2_5:
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	musb_disable_runtime_pm(musb);
 shutdown_phy:
@@ -2733,6 +2780,7 @@
 	goto release_pm;
 
 err_usb_phy_init:
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	musb_disable_runtime_pm(musb);
 release_pm:
@@ -2740,6 +2788,7 @@
 	musb_release_session(musb);
 
 fail2:
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	if (musb->irq_wake)
 		device_init_wakeup(dev, 0);
@@ -2793,6 +2842,7 @@
 	cancel_delayed_work_sync(&musb->finish_resume_work);
 	cancel_delayed_work_sync(&musb->deassert_reset_work);
 	pm_runtime_get_sync(musb->controller);
+	musb_quiesce_mailbox(musb);
 	musb_shutdown_resume_work(musb);
 	musb_host_cleanup(musb);
 	musb_gadget_cleanup(musb);
@@ -2804,7 +2854,6 @@
 
 	pm_runtime_put_noidle(musb->controller);
 	musb_release_session(musb);
-	musb_phy_callback = NULL;
 	if (musb->dma_controller)
 		musb_dma_controller_destroy(musb->dma_controller);
 	usb_phy_shutdown(musb->xceiv);
--- a/drivers/usb/musb/musb_core.h
+++ b/drivers/usb/musb/musb_core.h
@@ -140,7 +140,8 @@
  * @set_vbus:	forces vbus status
  * @pre_root_reset_end: called before the root usb port reset flag gets cleared
  * @post_root_reset_end: called after the root usb port reset flag gets cleared
- * @phy_callback: optional callback function for the phy to call
+ * @phy_callback: non-sleeping PHY event publication for the owning controller
+ * @phy_callback_quiesce: drain backend event/child users before client teardown
  */
 struct musb_platform_ops {
 
@@ -190,7 +191,8 @@
 
 	void	(*pre_root_reset_end)(struct musb *musb);
 	void	(*post_root_reset_end)(struct musb *musb);
-	int	(*phy_callback)(enum musb_vbus_id_status status);
+	int	(*phy_callback)(struct musb *musb, enum musb_vbus_id_status status);
+	void	(*phy_callback_quiesce)(struct musb *musb);
 	void	(*clear_ep_rxintr)(struct musb *musb, int epnum);
 };
 
--- a/drivers/usb/musb/omap2430.c
+++ b/drivers/usb/musb/omap2430.c
@@ -9,6 +9,7 @@
