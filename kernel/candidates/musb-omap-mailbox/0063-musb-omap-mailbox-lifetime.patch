  */
 #include <linux/module.h>
+#include <linux/srcu.h>
 #include <linux/kernel.h>
 #include <linux/sched.h>
 #include <linux/init.h>
@@ -33,6 +34,10 @@
 	struct platform_device	*musb;
 	enum musb_vbus_id_status status;
 	struct work_struct	omap_musb_mailbox_work;
+	struct srcu_struct	child_srcu;
+	struct musb __rcu	*active_musb;
+	/* Protect cached status only; no callback or wait holds this lock. */
+	spinlock_t		status_lock;
 	struct device		*control_otghs;
 	unsigned int		is_runtime_suspended:1;
 	unsigned int		needs_resume:1;
@@ -40,7 +45,27 @@
 };
 #define glue_to_musb(g)		platform_get_drvdata(g->musb)
 
-static struct omap2430_glue	*_glue;
+static void omap2430_cleanup_srcu(void *data)
+{
+	struct omap2430_glue *glue = data;
+
+	cleanup_srcu_struct(&glue->child_srcu);
+}
+
+/* Child device lock serializes init/quiesce; readers never acquire that lock. */
+static void omap2430_musb_quiesce(struct musb *musb)
+{
+	struct omap2430_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (rcu_access_pointer(glue->active_musb) != musb)
+		return;
+
+	/* A running worker may still need the parent's runtime-resume callback. */
+	disable_work_sync(&glue->omap_musb_mailbox_work);
+	RCU_INIT_POINTER(glue->active_musb, NULL);
+	synchronize_srcu(&glue->child_srcu);
+}
+
 
 static inline void omap2430_low_level_exit(struct musb *musb)
 {
@@ -61,24 +86,25 @@
 	musb_writel(musb->mregs, OTG_FORCESTDBY, l);
 }
 
-static int omap2430_musb_mailbox(enum musb_vbus_id_status status)
-{
-	struct omap2430_glue	*glue = _glue;
-
-	if (!glue) {
-		pr_err("%s: musb core is not yet initialized\n", __func__);
-		return -EPROBE_DEFER;
-	}
+static int omap2430_musb_mailbox(struct musb *musb,
+				 enum musb_vbus_id_status status)
+{
+	struct omap2430_glue *glue = dev_get_drvdata(musb->controller->parent);
+	unsigned long flags;
+	int idx, ret = -EPROBE_DEFER;
+
+	idx = srcu_read_lock(&glue->child_srcu);
+	if (srcu_dereference(glue->active_musb, &glue->child_srcu) != musb)
+		goto out;
+
+	spin_lock_irqsave(&glue->status_lock, flags);
 	glue->status = status;
-
-	if (!glue_to_musb(glue)) {
-		pr_err("%s: musb core is not yet ready\n", __func__);
-		return -EPROBE_DEFER;
-	}
-
+	spin_unlock_irqrestore(&glue->status_lock, flags);
 	schedule_work(&glue->omap_musb_mailbox_work);
-
-	return 0;
+	ret = 0;
+out:
+	srcu_read_unlock(&glue->child_srcu, idx);
+	return ret;
 }
 
