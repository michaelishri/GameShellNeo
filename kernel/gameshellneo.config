# Diagnostic CPI v3.1 fragment over the locked upstream sunxi_defconfig.
CONFIG_LOCALVERSION_AUTO=n
CONFIG_NR_CPUS=4
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_PM=y
# Manual freezer/devices debug tests only; systemd sleep remains disabled.
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_AUTOSLEEP=n
CONFIG_PM_WAKELOCKS=n
CONFIG_PM_TEST_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=n
CONFIG_ARM_PSCI=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CPUIDLE=n
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_SUN4I_GPADC=y
CONFIG_SENSORS_IIO_HWMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_100=y
CONFIG_AUDIT=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
# Match the service isolation and journal ACL features used by Debian/systemd.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_NETFILTER=y
# Load after the root filesystem so regulatory.db and its signature are available.
CONFIG_CFG80211=m
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_CFG80211_WEXT=n
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RFKILL=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_AXP20X_PEK=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_BACKEND=y
CONFIG_DRM_PANEL_CLOCKWORKPI_GAMESHELL=y
CONFIG_BACKLIGHT_OCP8178=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_DRM_LIMA=n
CONFIG_DRM_SUN4I_HDMI=n
CONFIG_DRM_SUN4I_HDMI_CEC=n
CONFIG_DRM_SUN8I_DW_HDMI=n
CONFIG_DRM_DW_HDMI=n
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_I2S=y
CONFIG_SND_SUN8I_CODEC=y
CONFIG_SND_SUN8I_CODEC_ANALOG=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SUN4I_CODEC=n
CONFIG_SND_SUN4I_SPDIF=n
CONFIG_SND_SOC_HDMI_CODEC=n
CONFIG_SND_USB_AUDIO=n
CONFIG_SND_SEQUENCER=n
CONFIG_SND_OSSEMUL=n
CONFIG_SND_PCM_OSS=n
CONFIG_SND_MIXER_OSS=n
CONFIG_SND_SUPPORT_OLD_API=n
CONFIG_SND_HRTIMER=n
CONFIG_BT=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_RC_CORE=n
CONFIG_CAN=n
CONFIG_ATA=n
CONFIG_TOUCHSCREEN_SUN4I=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_NFS_FS=n
CONFIG_ROOT_NFS=n
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_ETH=n
CONFIG_CONFIGFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_AXP20X_ADC=y
CONFIG_LEDS_GPIO=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_FS=y
# Opt-in keypad power/USB PM diagnostics. No function instrumentation.
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_FUNCTION_TRACER=n
CONFIG_FUNCTION_GRAPH_TRACER=n
CONFIG_FTRACE_SYSCALLS=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_WERROR=n
