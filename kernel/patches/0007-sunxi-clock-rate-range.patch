@@ -8,6 +8,7 @@
 
 #include <linux/compiler.h>
 #include <linux/clk-provider.h>
+#include <linux/math.h>
 
 #define CCU_FEATURE_FRACTIONAL		BIT(0)
 #define CCU_FEATURE_VARIABLE_PREDIV	BIT(1)
@@ -61,6 +62,24 @@
 
 void ccu_helper_wait_for_lock(struct ccu_common *common, u32 lock);
 
+/* The caller owns the rate-range snapshot for this comparison. */
+static inline bool ccu_is_better_rate_with_range(struct ccu_common *common,
+			unsigned long target_rate, unsigned long current_rate,
+			unsigned long best_rate, unsigned long min_rate,
+			unsigned long max_rate)
+{
+	if (current_rate > max_rate)
+		return false;
+
+	if (current_rate < min_rate)
+		return false;
+
+	if (common->features & CCU_FEATURE_CLOSEST_RATE)
+		return abs(current_rate - target_rate) < abs(best_rate - target_rate);
+
+	return current_rate <= target_rate && current_rate > best_rate;
+}
