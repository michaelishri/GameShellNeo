+/* F2 device lock held; retire parked workers before any synchronous drain. */
+static void brcmf_sdiod_pm_abort(struct brcmf_sdio_dev *sdiodev)
+{
+	if (!sdiodev->pm_suspended)
+		return;
+
+	sdio_claim_host(sdiodev->func1);
+	brcmf_sdio_pm_failed(sdiodev->bus);
+	brcmf_sdiod_pm_quiesce_irqs(sdiodev);
+	sdio_release_host(sdiodev->func1);
+	brcmf_sdiod_pm_disarm(sdiodev);
+	sdiodev->pm_suspended = false;
+	brcmf_sdiod_freezer_thaw(sdiodev->freezer);
+}
