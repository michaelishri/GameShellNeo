+static int brcmf_ops_sdio_suspend(struct device *dev)
+{
+	struct sdio_func *func = container_of(dev, struct sdio_func, dev);
+	struct brcmf_bus *bus_if;
+	struct device *f2dev;
+	int ret;
+
+	if (func->num != 1)
+		return 0;
+	/* The PM core holds F1; F2 removal never frees shared state. */
+	device_lock_assert(dev);
+	bus_if = dev_get_drvdata(dev);
+	if (!bus_if)
+		return -ENODEV;
+	f2dev = &bus_if->bus_priv.sdio->func2->dev;
+	mutex_lock_nested(&f2dev->mutex, SINGLE_DEPTH_NESTING);
+	ret = brcmf_sdiod_suspend(dev);
+	device_unlock(f2dev);
+	return ret;
+}
