+++ b/drivers/rtc/rtc-sun6i.c
@@ -146,6 +146,7 @@
 	const struct sun6i_rtc_clk_data *data;
 	void __iomem *base;
 	int irq;
+	bool wake_armed;
 	time64_t alarm;
 	unsigned long flags;
 
@@ -710,27 +711,40 @@
 };
 
 #ifdef CONFIG_PM_SLEEP
-/* Enable IRQ wake on suspend, to wake up from RTC. */
+static int sun6i_rtc_disarm_wake(struct sun6i_rtc_dev *chip)
+{
+	int ret;
+
+	if (!chip->wake_armed)
+		return 0;
+	ret = disable_irq_wake(chip->irq);
+	if (!ret)
+		chip->wake_armed = false;
+	return ret;
+}
+
+/* Arm only after any owned failed disarm has been resolved. */
 static int sun6i_rtc_suspend(struct device *dev)
 {
 	struct sun6i_rtc_dev *chip = dev_get_drvdata(dev);
-
-	if (device_may_wakeup(dev))
-		enable_irq_wake(chip->irq);
-
-	return 0;
-}
-
-/* Disable IRQ wake on resume. */
+	int ret;
+
+	ret = sun6i_rtc_disarm_wake(chip);
+	if (ret)
+		return ret;
+	if (!device_may_wakeup(dev))
+		return 0;
+	ret = enable_irq_wake(chip->irq);
+	if (!ret)
+		chip->wake_armed = true;
+	return ret;
+}
+
 static int sun6i_rtc_resume(struct device *dev)
 {
-	struct sun6i_rtc_dev *chip = dev_get_drvdata(dev);
-
-	if (device_may_wakeup(dev))
-		disable_irq_wake(chip->irq);
-
-	return 0;
-}
+	return sun6i_rtc_disarm_wake(dev_get_drvdata(dev));
+}
+
 #endif
 
 static SIMPLE_DEV_PM_OPS(sun6i_rtc_pm_ops,
diff --git a/drivers/power/supply/axp20x_ac_power.c b/drivers/power/supply/axp20x_ac_power.c
--- a/drivers/power/supply/axp20x_ac_power.c
+++ b/drivers/power/supply/axp20x_ac_power.c
@@ -44,6 +44,9 @@
 	struct iio_channel *acin_v;
 	struct iio_channel *acin_i;
 	bool has_acin_path_sel;
+	bool wake_armed;
+	bool irqs_disabled;
+	unsigned int disabled_from;
 	unsigned int num_irqs;
 	unsigned int irqs[] __counted_by(num_irqs);
 };
@@ -282,37 +285,58 @@
 };
 
 #ifdef CONFIG_PM_SLEEP
+static int axp20x_ac_power_disarm_wake(struct axp20x_ac_power *power)
+{
+	int ret;
+
+	if (!power->wake_armed)
+		return 0;
+	ret = disable_irq_wake(power->irqs[0]);
+	if (!ret)
+		power->wake_armed = false;
+	return ret;
+}
+
 static int axp20x_ac_power_suspend(struct device *dev)
 {
 	struct axp20x_ac_power *power = dev_get_drvdata(dev);
-	int i = 0;
-
-	/*
-	 * Allow wake via ACIN_PLUGIN only.
-	 *
-	 * As nested threaded IRQs are not automatically disabled during
-	 * suspend, we must explicitly disable the remainder of the IRQs.
-	 */
-	if (device_may_wakeup(&power->supply->dev))
-		enable_irq_wake(power->irqs[i++]);
+	int ret;
+	unsigned int i = 0;
+
+	ret = axp20x_ac_power_disarm_wake(power);
+	if (ret)
+		return ret;
+
+	/* Only AC insertion wakes; own the actual choice until resume. */
+	if (device_may_wakeup(&power->supply->dev)) {
+		ret = enable_irq_wake(power->irqs[0]);
+		if (ret)
+			return ret;
+		power->wake_armed = true;
+		i = 1;
+	}
+	power->disabled_from = i;
 	while (i < power->num_irqs)
 		disable_irq(power->irqs[i++]);
-
+	power->irqs_disabled = true;
 	return 0;
 }
 
 static int axp20x_ac_power_resume(struct device *dev)
 {
 	struct axp20x_ac_power *power = dev_get_drvdata(dev);
-	int i = 0;
-
-	if (device_may_wakeup(&power->supply->dev))
-		disable_irq_wake(power->irqs[i++]);
-	while (i < power->num_irqs)
-		enable_irq(power->irqs[i++]);
-
-	return 0;
-}
+	unsigned int i;
+	int ret;
+
+	ret = axp20x_ac_power_disarm_wake(power);
+	if (power->irqs_disabled) {
+		for (i = power->disabled_from; i < power->num_irqs; i++)
+			enable_irq(power->irqs[i]);
+		power->irqs_disabled = false;
+	}
+	return ret;
+}
+
 #endif
 
 static SIMPLE_DEV_PM_OPS(axp20x_ac_power_pm_ops, axp20x_ac_power_suspend,
