From: GameShellNeo contributors
Subject: [PATCH] brcmfmac: own transmit queue admission across suspend

Drain active netdev transmitters in wiphy suspend before the parent can
freeze transport workers. Hold a separate queue stop reason across both
bus and configuration restoration. A failed configuration or unavailable
transport closes carrier before relinquishing suspend ownership. Bus UP
rechecks existing stop reasons instead of waking queues unconditionally.
No generic DOWN lifetime change, packet replay or warning suppression.

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.h
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.h
@@ -160,11 +160,17 @@
  *	netif stopped due to flowring full.
  * @BRCMF_NETIF_STOP_REASON_DISCONNECTED:
  *	netif stopped due to not being connected (STA mode).
+ * @BRCMF_NETIF_STOP_REASON_NONE:
+ *	recheck queue admission without releasing another owner.
+ * @BRCMF_NETIF_STOP_REASON_SUSPEND:
+ *	netif stopped until wiphy resume has restored its configuration.
  */
 enum brcmf_netif_stop_reason {
+	BRCMF_NETIF_STOP_REASON_NONE = 0,
 	BRCMF_NETIF_STOP_REASON_FWS_FC = BIT(0),
 	BRCMF_NETIF_STOP_REASON_FLOW = BIT(1),
-	BRCMF_NETIF_STOP_REASON_DISCONNECTED = BIT(2)
+	BRCMF_NETIF_STOP_REASON_DISCONNECTED = BIT(2),
+	BRCMF_NETIF_STOP_REASON_SUSPEND = BIT(3)
 };
 
 /**
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
@@ -1559,7 +1559,6 @@
 void brcmf_bus_change_state(struct brcmf_bus *bus, enum brcmf_bus_state state)
 {
 	struct brcmf_pub *drvr = bus->drvr;
-	struct net_device *ndev;
 	int ifidx;
 
 	brcmf_dbg(TRACE, "%d -> %d\n", bus->state, state);
@@ -1572,14 +1571,12 @@
 	bus->state = state;
 
 	if (state == BRCMF_BUS_UP) {
-		for (ifidx = 0; ifidx < BRCMF_MAX_IFS; ifidx++) {
-			if ((drvr->iflist[ifidx]) &&
-			    (drvr->iflist[ifidx]->ndev)) {
-				ndev = drvr->iflist[ifidx]->ndev;
-				if (netif_queue_stopped(ndev))
-					netif_wake_queue(ndev);
-			}
-		}
+		/* Transport recovery cannot release another queue stop owner,
+		 * including the wiphy callback that has not resumed yet.
+		 */
+		for (ifidx = 0; ifidx < BRCMF_MAX_IFS; ifidx++)
+			brcmf_txflowblock_if(drvr->iflist[ifidx],
+					     BRCMF_NETIF_STOP_REASON_NONE, false);
 	}
 }
 
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -4163,6 +4163,44 @@
 
 #endif /* CONFIG_PM */
 
+/* RTNL and the wiphy lock stabilize the vif list across these callbacks. */
+static void brcmf_cfg80211_suspend_tx(struct brcmf_cfg80211_info *cfg)
+{
+	struct brcmf_cfg80211_vif *vif;
+
+	ASSERT_RTNL();
+	list_for_each_entry(vif, &cfg->vif_list, list) {
+		if (!vif->ifp->ndev)
+			continue;
+		brcmf_txflowblock_if(vif->ifp, BRCMF_NETIF_STOP_REASON_SUSPEND,
+				     true);
+		/* Do not hold netif_stop_lock here: ndo_start_xmit can acquire
+		 * it through firmware flow control. The SUSPEND reason prevents
+		 * other stop owners from reopening admission during this drain.
+		 */
+		netif_tx_disable(vif->ifp->ndev);
+	}
+}
+
+static void brcmf_cfg80211_resume_tx(struct brcmf_cfg80211_info *cfg, int err)
+{
+	struct brcmf_cfg80211_vif *vif;
+
+	ASSERT_RTNL();
+	list_for_each_entry(vif, &cfg->vif_list, list) {
+		if (!vif->ifp->ndev)
+			continue;
+		/* Failed configuration must not admit traffic before cfg80211
+		 * closes the interface. Clear only our owned suspend reason so
+		 * a subsequent explicit open/connect can recover normally.
+		 */
+		if (err || cfg->pub->bus_if->state != BRCMF_BUS_UP)
+			brcmf_net_setcarrier(vif->ifp, false);
+		brcmf_txflowblock_if(vif->ifp, BRCMF_NETIF_STOP_REASON_SUSPEND,
+				     false);
+	}
+}
+
 static int brcmf_cfg80211_apply_country(struct wiphy *wiphy, char alpha2[2]);
 
 static s32 brcmf_cfg80211_resume(struct wiphy *wiphy)
@@ -4170,6 +4208,7 @@
 	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
 	struct net_device *ndev = cfg_to_ndev(cfg);
 	struct brcmf_if *ifp = netdev_priv(ndev);
+	int err = 0;
 
 	ASSERT_RTNL();
 	brcmf_dbg(TRACE, "Enter\n");
@@ -4193,10 +4232,12 @@
 	}
 	/* The parent transport has resumed before this wiphy callback. */
 	cfg->regulatory_suspended = false;
-	if (!cfg->regulatory_pending)
-		return 0;
-	cfg->regulatory_pending = false;
-	return brcmf_cfg80211_apply_country(wiphy, cfg->regulatory_alpha2);
+	if (cfg->regulatory_pending) {
+		cfg->regulatory_pending = false;
+		err = brcmf_cfg80211_apply_country(wiphy, cfg->regulatory_alpha2);
+	}
+	brcmf_cfg80211_resume_tx(cfg, err);
+	return err;
 }
 
 static void brcmf_configure_wowl(struct brcmf_cfg80211_info *cfg,
@@ -4283,6 +4324,9 @@
 
 	ASSERT_RTNL();
 	brcmf_dbg(TRACE, "Enter\n");
+
+	/* Stop and drain netdev transmitters while the transport still runs. */
+	brcmf_cfg80211_suspend_tx(cfg);
 
 	/* if the primary net_device is not READY there is nothing
 	 * we can do but pray resume goes smoothly.
