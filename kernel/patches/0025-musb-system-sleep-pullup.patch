+/* System PM holds a runtime reference; never drain work under musb->lock. */
+void musb_gadget_suspend(struct musb *musb)
+{
+	unsigned long flags;
+
+	if (musb->port_mode != MUSB_PERIPHERAL ||
+	    device_may_wakeup(musb->controller) ||
+	    (musb->ops->quirks & MUSB_PRESERVE_SESSION))
+		return;
+
+	spin_lock_irqsave(&musb->lock, flags);
+	musb->gadget_suspended = 1;
+	spin_unlock_irqrestore(&musb->lock, flags);
+	cancel_delayed_work_sync(&musb->gadget_work);
+
+	spin_lock_irqsave(&musb->lock, flags);
+	/* Preserve softconnect intent; only remove the physical pull-up. */
+	musb_pullup(musb, 0);
+	spin_unlock_irqrestore(&musb->lock, flags);
+}
+
+/* Called under musb->lock, after context, interrupts and resume work. */
+void musb_gadget_resume(struct musb *musb)
+{
+	musb->gadget_suspended = 0;
+	musb_pullup(musb, musb->softconnect && musb->gadget_driver);
+}
+
 static void musb_gadget_work(struct work_struct *work)
 {
 	struct musb *musb;
 	unsigned long flags;
+	int ret;
 
 	musb = container_of(work, struct musb, gadget_work.work);
-	pm_runtime_get_sync(musb->controller);
