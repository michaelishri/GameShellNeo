Subject: [PATCH] cpuidle: allow an eligible state zero to enter suspend-to-idle

Keep deeper-state and ordinary-idle selection unchanged. Distinguish a
valid state-zero entry from no callback with a negative error, and update
the scheduler caller so a successful entry cannot fall through twice.

diff --git a/drivers/cpuidle/cpuidle.c b/drivers/cpuidle/cpuidle.c
--- a/drivers/cpuidle/cpuidle.c
+++ b/drivers/cpuidle/cpuidle.c
@@ -187,6 +187,9 @@
  *
  * If there are states with the ->enter_s2idle callback, find the deepest of
  * them and enter it with frozen tick.
+ *
+ * Return: the entered state index (including 0), or -ENODEV if no suitable
+ * state is available. A negative return leaves local IRQ state unchanged.
  */
 int cpuidle_enter_s2idle(struct cpuidle_driver *drv, struct cpuidle_device *dev)
 {
@@ -198,10 +201,14 @@
 	 * be frozen safely.
 	 */
 	index = find_deepest_state(drv, dev, U64_MAX, 0, true);
-	if (index > 0) {
-		enter_s2idle_proper(drv, dev, index);
-		local_irq_enable();
-	}
+	/* The shared selector uses 0 as its ordinary-idle fallback. */
+	if (!index && (!drv->states[0].enter_s2idle ||
+		       dev->states_usage[0].disable ||
+		       (drv->states[0].flags & CPUIDLE_FLAG_COUPLED)))
+		return -ENODEV;
+
+	enter_s2idle_proper(drv, dev, index);
+	local_irq_enable();
 	return index;
 }
 #endif /* CONFIG_SUSPEND */
diff --git a/kernel/sched/idle.c b/kernel/sched/idle.c
--- a/kernel/sched/idle.c
+++ b/kernel/sched/idle.c
@@ -215,7 +215,7 @@
 		if (idle_should_enter_s2idle()) {
 
 			entered_state = call_cpuidle_s2idle(drv, dev);
-			if (entered_state > 0)
+			if (entered_state >= 0)
 				goto exit_idle;
 
 			max_latency_ns = U64_MAX;
