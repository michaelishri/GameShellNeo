Subject: [PATCH] extcon: test linked provider admission and removal

Exercise real driver-core binding, failure and concurrent removal paths.
Use synthetic platform devices and firmware nodes; no hardware is needed.

diff --git a/drivers/extcon/Kconfig b/drivers/extcon/Kconfig
--- a/drivers/extcon/Kconfig
+++ b/drivers/extcon/Kconfig
@@ -236,4 +236,14 @@
 	  against the real SRCU and scheduler implementation. These tests
 	  create synthetic providers and do not need physical connectors.
 
+config EXTCON_PROVIDER_KUNIT_TEST
+	tristate "Extcon provider lifetime KUnit tests" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+	help
+	  Exercise linked provider lookup and driver-core unbind ordering
+	  using synthetic devices, firmware nodes and kernel threads.
+	  Check admission during probe/removal and callback drain ordering.
+	  These tests need no physical connectors or USB controller.
+
 endif
diff --git a/drivers/extcon/Makefile b/drivers/extcon/Makefile
--- a/drivers/extcon/Makefile
+++ b/drivers/extcon/Makefile
@@ -29,3 +29,4 @@
 obj-$(CONFIG_EXTCON_USBC_TUSB320) += extcon-usbc-tusb320.o
 obj-$(CONFIG_EXTCON_RTK_TYPE_C) += extcon-rtk-type-c.o
 obj-$(CONFIG_EXTCON_NOTIFIER_KUNIT_TEST) += extcon-notifier-test.o
+obj-$(CONFIG_EXTCON_PROVIDER_KUNIT_TEST) += extcon-provider-test.o
