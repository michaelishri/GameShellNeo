From: GameShellNeo contributors
Subject: [PATCH] usb: musb: own deferred restarts per endpoint

Queue a coalesced endpoint restart instead of retaining a request pointer
across runtime resume. Resolve the current queue head under the controller
lock. Remove work entries before callbacks and drop list_lock around them.

If resume overlaps a giveback, retain the restart obligation and a runtime-PM
reference until the outermost giveback restores the endpoint's busy state.
Restart then, or retire the obligation at the end of nuke. The extra PM
reference exists only for this overlap, not for ordinary completions.

Keep the first callback error and continue draining other pending work.
Failed-queue DMA mapping and complete controller removal remain separate.

diff --git a/drivers/usb/musb/musb_core.c b/drivers/usb/musb/musb_core.c
--- a/drivers/usb/musb/musb_core.c
+++ b/drivers/usb/musb/musb_core.c
@@ -2210,27 +2210,41 @@
 /*
  * Called from musb_runtime_resume(), musb_resume(), and
  * musb_queue_resume_work(). Callers must take musb->lock.
+ *
+ * Entries are removed before their callback runs, and callbacks run with
+ * list_lock released so they can enter musb_gadget paths that queue further
+ * pending work (for example a completed request re-queued from its
+ * completion callback) without deadlocking on the list they iterate.
  */
 static int musb_run_resume_work(struct musb *musb)
 {
-	struct musb_pending_work *w, *_w;
+	struct musb_pending_work *w;
 	unsigned long flags;
-	int error = 0, ret;
+	int error = 0;
 
 	spin_lock_irqsave(&musb->list_lock, flags);
-	list_for_each_entry_safe(w, _w, &musb->pending_list, node) {
-		if (w->callback) {
-			ret = w->callback(musb, w->data);
-			if (ret < 0) {
-				if (!error)
-					error = ret;
-				dev_err(musb->controller,
-					"resume callback %p failed: %i\n",
-					w->callback, ret);
-			}
-		}
+	while ((w = list_first_entry_or_null(&musb->pending_list,
+					     struct musb_pending_work, node))) {
+		int	(*callback)(struct musb *musb, void *data);
+		void	*data;
+		int	ret;
+
+		callback = w->callback;
+		data = w->data;
 		list_del(&w->node);
 		devm_kfree(musb->controller, w);
+		spin_unlock_irqrestore(&musb->list_lock, flags);
+
+		ret = callback(musb, data);
+		if (ret < 0) {
+			if (!error)
+				error = ret;
+			dev_err(musb->controller,
+				"resume callback %p failed: %i\n",
+				callback, ret);
+		}
+
+		spin_lock_irqsave(&musb->list_lock, flags);
 	}
 	spin_unlock_irqrestore(&musb->list_lock, flags);
 
@@ -2241,6 +2255,7 @@
 /*
  * Called to run work if device is active or else queue the work to happen
  * on resume. Caller must take musb->lock and must hold an RPM reference.
+ * Callbacks run without list_lock held and may queue further work.
  *
  * Note that we cowardly refuse queuing work after musb PM runtime
  * resume is done calling musb_run_resume_work() and return -EINPROGRESS
diff --git a/drivers/usb/musb/musb_gadget.c b/drivers/usb/musb/musb_gadget.c
--- a/drivers/usb/musb/musb_gadget.c
+++ b/drivers/usb/musb/musb_gadget.c
@@ -113,6 +113,25 @@
 	request->map_state = UN_MAPPED;
 }
 
+static int musb_ep_restart_resume_work(struct musb *musb, void *data);
+
+/* Finish a restart handed off by resume while giveback dropped musb->lock. */
+static void musb_ep_finish_restart(struct musb_ep *ep, bool restart)
+{
+	struct musb *musb = ep->musb;
+
+	if (!ep->restart_deferred)
+		return;
+
+	ep->restart_deferred = false;
+	if (restart)
+		musb_ep_restart_resume_work(musb, ep);
+	else
+		ep->restart_pending = false;
+	pm_runtime_mark_last_busy(musb->controller);
+	pm_runtime_put_autosuspend(musb->controller);
+}
+
 /*
  * Immediately complete a request.
  *
@@ -133,6 +152,8 @@
 
 	req = to_musb_request(request);
 
+	if (ep->restart_pending && ep->req_list.next == &req->list)
+		ep->restart_again = true;
 	list_del(&req->list);
 	if (req->request.status == -EINPROGRESS)
 		req->request.status = status;
@@ -148,6 +169,8 @@
 	usb_gadget_giveback_request(&req->ep->end_point, &req->request);
 	spin_lock(&musb->lock);
 	ep->busy = busy;
+	if (!busy)
+		musb_ep_finish_restart(ep, true);
 }
 
 /* ----------------------------------------------------------------------- */
@@ -195,6 +218,9 @@
 		req = list_first_entry(&ep->req_list, struct musb_request, list);
 		musb_g_giveback(ep, &req->request, status);
 	}
+
+	/* nuke keeps busy set: retire any restart handed to a giveback. */
+	musb_ep_finish_restart(ep, false);
 }
 
 /* ----------------------------------------------------------------------- */
@@ -1179,10 +1205,31 @@
 
 static int musb_ep_restart_resume_work(struct musb *musb, void *data)
 {
-	struct musb_request *req = data;
-
-	musb_ep_restart(musb, req);
-
+	struct musb_ep *ep = data;
+	struct musb_request *req;
+
+	do {
+		ep->restart_again = false;
+		req = next_request(ep);
+		if (!ep->desc)
+			break;
+		if (ep->busy) {
+			/*
+			 * Giveback dropped the controller lock. Keep ownership
+			 * and power until its outermost callback returns; nuke
+			 * retires the obligation if the endpoint is stopping.
+			 */
+			ep->restart_deferred = true;
+			pm_runtime_get_noresume(musb->controller);
+			return 0;
+		}
+		if (!req)
+			break;
+		musb_ep_restart(musb, req);
+		/* A synchronous completion may have installed another head. */
+	} while (ep->restart_again);
+
+	ep->restart_pending = false;
 	return 0;
 }
 
@@ -1246,13 +1293,22 @@
 
 	/* it this is the head of the queue, start i/o ... */
 	if (!musb_ep->busy && &request->list == musb_ep->req_list.next) {
-		status = musb_queue_resume_work(musb,
-						musb_ep_restart_resume_work,
-						request);
-		if (status < 0) {
-			dev_err(musb->controller, "%s resume work: %i\n",
-				__func__, status);
-			list_del(&request->list);
+		/*
+		 * One deferred restart per endpoint is enough: it restarts
+		 * the queue head it finds at resume time, so additional
+		 * head requests queued while suspended are covered too.
+		 */
+		if (!musb_ep->restart_pending) {
+			musb_ep->restart_pending = true;
+			status = musb_queue_resume_work(musb,
+							musb_ep_restart_resume_work,
+							musb_ep);
+			if (status < 0) {
+				dev_err(musb->controller, "%s resume work: %i\n",
+					__func__, status);
+				list_del(&request->list);
+				musb_ep->restart_pending = false;
+			}
 		}
 	}
 
diff --git a/drivers/usb/musb/musb_gadget.h b/drivers/usb/musb/musb_gadget.h
--- a/drivers/usb/musb/musb_gadget.h
+++ b/drivers/usb/musb/musb_gadget.h
@@ -99,6 +99,13 @@
 	/* true if lock must be dropped but req_list may not be advanced */
 	u8				busy;
 
+	/* restart owned by pending work or an outstanding giveback */
+	bool				restart_pending;
+	/* giveback owns the restart and one controller runtime-PM reference */
+	bool				restart_deferred;
+	/* the owned restart completed its head and must inspect the next */
+	bool				restart_again;
+
 	u8				hb_mult;
 };
 
