[Unit]
Description=GameShellNeo awake critical-battery guard
After=systemd-udev-trigger.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/gameshellneo/battery_guard.py
Restart=on-failure
RestartSec=10
RuntimeDirectory=gameshellneo
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/gameshellneo

[Install]
WantedBy=multi-user.target
