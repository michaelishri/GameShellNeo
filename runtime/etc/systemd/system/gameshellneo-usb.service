[Unit]
Description=GameShellNeo USB ECM maintenance link
After=systemd-udev-trigger.service
Before=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gameshellneo-usb start
ExecStop=/usr/local/sbin/gameshellneo-usb stop
RemainAfterExit=yes
Restart=on-failure
RestartSec=3
TimeoutStartSec=15
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
